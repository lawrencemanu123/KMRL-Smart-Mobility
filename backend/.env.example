# KMLR Environment Configuration

# Database: Default SQLite for zero-setup local demo; or PostgreSQL in production
DATABASE_URL=sqlite:///./kmlr.db
# DATABASE_URL=postgresql://kmlr_user:kmlr_password@localhost:5432/kmlr_db

# Security & JWT
SECRET_KEY=kmlr-kochi-transit-super-secret-jwt-key-2026
